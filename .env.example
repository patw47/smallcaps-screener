# Envoi Telegram — LAISSER VIDE pour désactiver l'envoi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# EDGAR (dépôts officiels SEC). User-Agent identifiant EXIGÉ par la SEC (nom + email réel),
# sinon EDGAR est désactivé (drapeaux neutres). Exemple : "SmallCaps Screener you@example.com"
EDGAR_USER_AGENT=

# Production : refuse de démarrer sans config/local.yml
REQUIRE_LOCAL_CONFIG=1
